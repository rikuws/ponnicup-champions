{
  "name": "ponnicup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/seed.ts",
    "sync": "node --env-file-if-exists=.env --import tsx server/sync.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qa:seed": "node --import tsx scripts/seed-qa.ts"
  },
  "dependencies": {
    "lucide-react": "1.21.0",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "railway": "^3.11.0",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.5"
  }
}
